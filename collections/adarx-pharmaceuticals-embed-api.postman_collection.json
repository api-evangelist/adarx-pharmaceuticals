          "name": "Render the Yoast SEO head for a URL",
          "request": {
            "name": "Render the Yoast SEO head for a URL",
            "description": {
              "content": "Returns the full `<head>` SEO block for any URL on the site, including the schema.org JSON-LD `@graph`. This is the machine-readable structured-data surface of the site; the same graph is embedded per-object as `yoast_head_json` on posts and pages.",
